# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/fcc?schema=public"

# --- Application ----------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Cryptography ---------------------------------------------------------
# 32 random bytes, base64 encoded. Seals provider access tokens and TOTP
# secrets with AES-256-GCM. Losing this makes linked institutions unreadable;
# rotate by incrementing the version and re-sealing existing rows.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION="1"

# 32 random bytes, base64 encoded. Mixed into session token hashing.
SESSION_SECRET=""

# --- Financial aggregation ------------------------------------------------
# "demo" runs the entire application, including linking and sync, with
# deterministic synthetic data and no provider credentials.
# "plaid" uses the real Plaid API and requires the keys below.
AGGREGATION_PROVIDER="demo"

# Server-only. These must never be given a NEXT_PUBLIC_ prefix; lib/env.ts
# refuses to start if they are.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | development | production
PLAID_ENV="sandbox"
# Publicly reachable HTTPS URL for /api/webhooks/plaid. Optional in sandbox.
PLAID_WEBHOOK_URL=""
